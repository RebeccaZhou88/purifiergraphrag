# ===== Neo4j =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-password
NEO4J_HOST=localhost

# ===== LLM via Azure AI Foundry =====
# Provider: qwen | deepseek | azure_openai
LLM_PROVIDER=qwen

# Qwen (Azure AI Foundry deployment)
QWEN_ENDPOINT=https://<foundry>.services.ai.azure.com/models
QWEN_API_KEY=your-qwen-key
QWEN_MODEL=qwen-plus

# DeepSeek
DEEPSEEK_ENDPOINT=https://<foundry>.services.ai.azure.com/models
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_MODEL=deepseek-chat

# Azure OpenAI (对照)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=your-aoai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ===== App =====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# 是否在启动时自动导入种子数据
SEED_ON_STARTUP=true

# ===== Azure AI Foundry 评估 =====
FOUNDRY_ENDPOINT=https://<foundry>.services.ai.azure.com/api/projects/<project>
FOUNDRY_TENANT_ID=your-tenant-id
